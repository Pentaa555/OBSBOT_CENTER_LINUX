QLineEdit, QPlainTextEdit {
    color: rgb(255, 255, 255);
    background-color: transparent;
    border-image: url(:/pic/images/pic_bg2_74x25.png) 3px;
    border-width: 3px;
    padding-left: 14px;
    padding-top: 0px;
    padding-bottom: 2px;
    font-size: 14px;
}

QTextEdit {
    color: rgb(255, 255, 255);
    background-color: transparent;
    border-width: 0px;
    font-size: 14px;
    selection-background-color: rgb(96, 96, 96);
}

.RMButton {
    background-color: transparent;
    border-image: url(:/pic/images/pic_bg1_106x25.png) 3px;
    border-width: 3px;
}

/* > 表示匹配 RMButton 容器下面所有的 QPushButton */
RMButton > QPushButton {
    background-color: rgb(55, 58, 60);
    color: rgb(255, 255, 255);
    font-size: 14px;
    border-radius: 4px;
    padding-top: 0px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

RMButton > QPushButton:hover {
    background-color: rgb(45, 48, 50);
}

RMButton > QPushButton:pressed {
    padding-left: 8px;
    padding-bottom: 0px;
}

RMButton > QPushButton:disabled {
    background-color: rgb(55, 58, 60);
}

RMButtons#pbNvidiaBlurEffect, RMButtons#pbSingleRecModeSelect, RMButtons#pbSingleRecPlaySetting,
    RMButtons#pbScreenMode, RMButtons#pbBeautyResize, RMButtons#pbBeautyBgType {
    background-color: transparent;
    border-image: url(:/pic/images/pic_bg2_74x25.png) 3px;
    border-width: 3px;
}

RMButtons#pbPreviewSwitch {
    background-color: transparent;
    border-image: url(:/pic/images/pic_bg2_74x25.png);
}

RMButtons#pbPreviewSwitch > QPushButton {
    background-color: transparent;
    border-radius: 4px;
    padding: 0px;
}

RMButtons#pbPreviewSwitch > QPushButton:checked {
	padding: 0px;
    background-color: rgb(100, 103, 109);
}

RMButtons > QPushButton {
    border-radius: 4px;
    background-color: transparent;
    color: rgb(255, 255, 255);
    padding-top: 0px;
    padding-bottom: 2px;
}

RMButtons > QPushButton:checked {
    background-color: rgb(230, 0, 51);
    color: rgb(255, 255, 255);
}

RMButtons > QPushButton:disabled:checked {
    background-color: rgb(55, 58, 60);
    color: rgba(255, 255, 255, 102);
}

RMButtons > QPushButton:disabled:!checked {
    background-color: transparent;
    color: rgba(255, 255, 255, 102);
}

