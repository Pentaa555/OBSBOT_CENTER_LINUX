}

.QPushButton[themeID="btn_virtual_human"]:checked:hover {
    border-image: url(:/btn/images/btn_virtual_human_on_48x48.png);
}

QMenu {
    background-color: rgb(21, 22, 23);
    border: 1px solid rgb(81, 81, 81);
    border-radius: 8px;
    font-size: 14px;
}

QMenu::item {
    padding: 2px 10px 2px 10px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: 4px;
    margin: 2px;
    color: rgb(255, 255, 255);
}

QMenu::item:selected {
    background-color: rgb(34, 36, 38);
}

QMenu::separator {
    height: 1px;
    background-color: rgb(52, 52, 52);
    margin-left: 10px;
    margin-right: 10px;
}

QMenu::icon {
    width: 15px;
    height: 15px;
    padding-left: 15px;
}

QMenu#ResolutionMenu::item:selected {
    background-color: rgba(34, 36, 38, 1);
    border-radius: 6px;
}

/* QSlider */
QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    border-radius: 2px;
    background-color: transparent;
    height: 5px;
    padding: 0px 0px;
}

QSlider::handle:horizontal {
    background-color: rgb(255, 255, 255);
    border: none;
    width: 13px;
    border-radius: 6px;
    margin: -4px 0;
}

QSlider::handle:horizontal:disabled {
    background-color: rgb(128, 128, 128);
}

QSlider::sub-page:horizontal {
    background: rgb(213, 14, 56);
    border-top: 1px solid rgb(125, 5, 23);
    border-bottom: 1px solid rgb(45, 0, 3);
    border-left: 1px solid rgb(111, 6, 30);
    border-radius: 2px;
    margin: 0px 0px 0px 0px;
}

QSlider::sub-page:horizontal:disabled {
    background: rgb(98, 95, 99);
    border-top: 1px solid rgb(13, 10, 14);
    border-bottom: 1px solid rgb(19, 16, 19);
    border-left: 1px solid rgb(74, 71, 74);
    border-radius: 2px;
    margin: 0px 0px 0px 0px;
}

QSlider::add-page:horizontal {
    background: rgb(8, 10, 11);
    border-top: 1px solid rgb(5, 7, 9);
    border-bottom: 1px solid rgb(22, 24, 25);
    border-radius: 2px;
    margin: 0px 0px 0px 0px;
}

/* ScrollArea */
QScrollBar:vertical {
    width: 6px;
    border: none;
    background-color: transparent;
}

QScrollBar::handle:vertical {
    min-height: 100px;
    background: #6A6F73;
    border-radius: 3px;
}

QScrollBar::sub-line:vertical {
    background: transparent;
}

QScrollBar::add-line:vertical {
    background: transparent;
}

QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar::add-page:vertical {
    background: transparent;
}

/* Spinbox and doubleSpinbox */
QSpinBox, QDoubleSpinBox {
    color: rgb(231, 231, 231);
    background-color: transparent;
    padding-left: 3px;
    font-size: 12px;
    border-image: url(:/pic/images/pic_bg2_74x25.png) 3px;
    border-width: 3px;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: rgba(255, 255, 255, 102);
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    width: 12px;
    padding-top: 2px;
    padding-right: 2px;
    background-color: transparent;
    border-width: 0px;
    border-top-right-radius: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: margin;
    subcontrol-position: bottom right;
    width: 12px;
    padding-right: 2px;
    padding-bottom: 3px;
    background-color: transparent;
    border-width: 0px;
    border-bottom-right-radius: 2px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icon/images/icon_arrow_up2_on_24x18.png);
    width: 12px;
    height: 9px;
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off {
    image: url(:/icon/images/icon_arrow_up2_dis_24x18.png);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icon/images/icon_arrow_down2_on_24x18.png);
    width: 12px;
    height: 9px;
}

QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: url(:/icon/images/icon_arrow_down2_dis_24x18.png);
    width: 12px;
    height: 9px;
}

QCheckBox {
    spacing: 10px;
    background-color: transparent;
    border: none;
    color: rgba(255, 255, 255, 255);
    font-size: 14px;
}

QCheckBox:disabled {
    color: rgba(255, 255, 255, 102);
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: rgb(25, 27, 29);
    border: none;
    border-radius: 3px;
    image: url(:/icon/images/icon_select_off_36x36.png);
}

QCheckBox::indicator:checked {
    image: url(:/icon/images/icon_select_on_36x36.png);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/icon/images/icon_select_on_dis_36x36.png);
}

QCheckBox::indicator:disabled {
    image: url(:/icon/images/icon_select_off_dis_36x36.png);
}

/* QComboBox */
QComboBox {
    color: rgb(255, 255, 255);
    background-color: transparent;
    border-image: url(:/pic/images/pic_bg1_106x25.png) 3px;
    border-width: 3px;
    padding-left: 14px;
    padding-top: 0px;
    padding-bottom: 2px;
    font-size: 14px;
}

QComboBox:disabled {
    color: rgba(255, 255, 255, 102);
}

QComboBox QAbstractItemView {
    color: rgb(255, 255, 255);
    outline: 0px;
    font-size: 14px;
    padding: 0px;
    border-top: 1px solid rgb(48, 49, 49);
    border-bottom: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(34, 34, 35), stop: 0.66 rgb(42, 42, 42));
    border-left: 1px solid rgb(61, 61, 61);
    border-right: 1px solid rgb(61, 61, 61);
    background-color: rgb(21, 22, 23);
    /*selection-background-color: rgb(9, 9, 9);*/
    border-radius: 8px;
}

QComboBox QAbstractItemView::item {
    height: 32px;
    border-radius: 6px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:disabled {
    color: rgba(255, 255, 255, 102);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgb(34, 36, 38);
    border-width: 1px;
    border-color: rgb(1, 123,11);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    height: 20px;

    background-color: transparent;
    border-image: url(":/pic/images/pic_bg4_48x50.png") 0px;
}

QComboBox#cbImage::drop-down {
    width: 22px;
}

QComboBox::down-arrow {
    border-image: url(:/icon/images/icon_arrow_down1_on_36x36.png);
    qproperty-iconSize: 20px 20px;
}

QComboBox::down-arrow:disabled {
    border-image: url(:/icon/images/icon_arrow_down1_dis_36x36.png);
}

QComboBox::down-arrow:on {
    top: 0px;
    left: 0px;
}

