}

.QPushButton[themeID="msg_btn"] {
    background-color: rgb(55, 58, 60);
    border-top: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(36, 38, 40), stop: 0.66 rgb(65, 69, 72));
    border-bottom: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(43, 45, 47), stop: 0.66 rgb(18, 19, 20));
    border-radius: 4px;
    font-size: 14px;
}

.QPushButton[themeID="msg_btn"]:hover {
    background-color: rgb(45, 48, 50);
    border-top: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(26, 28, 30), stop: 0.66 rgb(55, 59, 62));
    border-bottom: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(33, 35, 37), stop: 0.66 rgb(18, 19, 20));
}

.QPushButton[themeID="msg_btn"]:pressed {
    background-color: rgb(35, 38, 40);
    border-top: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(16, 18, 20), stop: 0.66 rgb(45, 49, 52));
    border-bottom: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(23, 25, 27), stop: 0.66 rgb(8, 9, 10));
    padding-left: 2px;
    padding-top: 1px;
}

