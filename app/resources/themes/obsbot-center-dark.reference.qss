    border-top: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(64, 69, 72), stop: 0.66 rgb(63, 67, 69));
    border-bottom: 1px solid rgb(32, 34, 35);
    border-radius: 6px;
    background-color: rgb(55, 58, 60);
    padding-top: -2px;
}

QPushButton[themeID="dev_ctrl"]:checked {
    color: white;
    border-top: 2px solid QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(182, 68, 68), stop: 0.66 rgb(238, 27, 61));
    border-bottom: 1px solid rgb(94, 19, 37);
    background-color: rgb(230, 0, 51);
}

QPushButton[themeID="dev_ctrl"]:disabled {
    color: rgba(255, 255, 255, 102);
    border-top: 2px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(64, 69, 72), stop: 0.66 rgb(63, 67, 69));
    border-bottom: 1px solid rgb(32, 34, 35);
