.QWidget#wAudioOutput, .QWidget#wMultiTakePhoto {
    border-top: 1px solid QLinearGradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0.33 rgb(64, 69, 72), stop: 0.66 rgb(63, 67, 69));
    border-bottom: 1px solid rgb(32, 34, 35);
    border-radius: 4px;
    background-color: rgb(54, 58, 60);
}

QWidget#wSelect, QWidget#wBeautySelect, QWidget#wVideoSelect {
    border-radius: 6px;
    background-color: rgba(8, 10, 11, 1);
}

.QWidget[themeID="w_material_add_first"] {
