/* Custom theme information. This will set the application's QPalette, as well as pass to QML via the RMTheme object.
 * Can also use RMTheme::disabled, RMTheme::active, and RMTheme::inactive.
 * Using it without will set all three (making 'active' a bit redundant) */
RMTheme {
    window: rgb(55, 58, 60); /* dark */
    windowText: rgb(225, 224, 225); /* veryLight */
    base: rgb(31, 30, 31); /* veryDark */
    alternateBase: rgb(11, 10, 11); /* veryVeryDark */
    text: rgb(225, 224, 225); /* veryLight */
    buttons: rgb(88, 87, 88); /* kindaDark */
    buttonText: rgb(225, 224, 225); /* veryLight */
    brightText: rgb(200, 199, 200); /* lighter */

    light: rgb(88, 87, 88); /* kindaDark */
    mid: rgb(58, 57, 58); /* dark */
    dark: rgb(31, 30, 31); /* veryDark */
    shadow: rgb(11, 10, 11); /* veryVeryDark */

    highlight: rgba(0, 0, 0, 0); /* transparent */
    highlightedText: rgb(255, 255, 255);

    link: rgb(114, 162, 255); /* RM blue */
    linkVisited: rgb(114, 162, 255); /* RM blue */
}

RMTheme::disabled {
    text: rgb(122, 121, 122); /* light */
    buttonText: rgb(122, 121, 122); /* light */
    brightText: rgb(122, 121, 122); /* light */
}

RMTheme::inactive {
    highlight: rgb(48, 47, 48);
    highlightedText: rgb(255, 255, 255);
}

/* Label */

QLabel {
    color: rgb(255, 255, 255);
    background-color: transparent;
    font-size: 14px;
}

QLabel:disabled {
    color: rgba(255, 255, 255, 102);
}

QLabel[themeID="label_40"] {
    font-size: 40px;
}

QLabel[themeID="label_24"] {
    font-size: 24px;
}

QLabel[themeID="label_18"] {
    font-size: 18px;
}

QLabel[themeID="label_16"] {
    font-size: 16px;
}

QLabel[themeID="label_15"] {
    font-size: 15px;
}

QLabel[themeID="label_14"] {
    font-size: 14px;
}

QLabel[themeID="label_13"] {
